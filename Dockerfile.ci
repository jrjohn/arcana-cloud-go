# ============================================
# Go Multi-Stage Dockerfile (CI)
# Go 1.24 / Gin / gRPC
# ============================================
FROM golang:1.27-alpine AS tester
WORKDIR /app
RUN apk add --no-cache git ca-certificates protobuf build-base
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN mkdir -p api/proto/pb && \
    protoc --go_out=api/proto/pb --go_opt=paths=source_relative \
           --go-grpc_out=api/proto/pb --go-grpc_opt=paths=source_relative \
           -I api/proto api/proto/*.proto
# The exit status of `go test` must reach Docker: with a bare `| tee` the step's status was tee's
# (always 0), so failing tests never failed the Jenkins "Docker Compose Build" stage.
# Capture go test's own status, print the coverage summary, then exit with it.
RUN set -o pipefail; \
    go test -tags !integration ./... \
      -coverprofile=/tmp/coverage.out -covermode=atomic \
      2>&1 | tee /tmp/test-results.txt; \
    rc=$?; \
    go tool cover -func=/tmp/coverage.out 2>/dev/null | tail -5; \
    if [ "$rc" -ne 0 ]; then echo "go test FAILED (exit $rc)"; grep -E '^(--- FAIL|FAIL)' /tmp/test-results.txt; fi; \
    exit $rc

FROM golang:1.27-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git ca-certificates protobuf build-base
RUN go install google.golang.org/protobuf/cmd/protoc-gen-go@v1.36.12 && \
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.6.2
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN mkdir -p api/proto/pb && \
    protoc --go_out=api/proto/pb --go_opt=paths=source_relative \
           --go-grpc_out=api/proto/pb --go-grpc_opt=paths=source_relative \
           -I api/proto api/proto/*.proto
COPY --from=tester /tmp/coverage.out /tmp/coverage.out
COPY --from=tester /tmp/test-results.txt /tmp/test-results.txt
RUN CGO_ENABLED=0 go build -ldflags="-w -s" -o server ./cmd/server

FROM alpine:3.24
RUN apk add --no-cache ca-certificates \
    && addgroup --system appgroup \
    && adduser --system --ingroup appgroup appuser
WORKDIR /app
COPY --from=builder /app/server .
COPY --from=builder /tmp/coverage.out /tmp/coverage.out
RUN chown appuser:appgroup /app/server
USER appuser
EXPOSE 8080
CMD ["/app/server"]
